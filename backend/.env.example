# Copy this file to .env and fill in real values. Never commit .env.
PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/sports-equipment
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Used in password-reset links AND as the only address allowed to call the API (CORS).
# Several addresses: separate with commas. In production use your real https address.
FRONTEND_URL=http://localhost:5173

# Reports and dashboards group days using this timezone
APP_TIMEZONE=Asia/Kolkata

# SMTP (Gmail: smtp.gmail.com:465 + App Password; Brevo: smtp-relay.brevo.com:587 + SMTP key).
# Leave credentials empty to print emails in the server log during local development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Equipment and profile photos (Cloudinary). Without these, photo upload answers 503
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
