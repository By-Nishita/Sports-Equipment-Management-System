# Copy this file to .env and fill in real values. Never commit .env.
PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/sports-equipment
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Used in password-reset links AND as the only address allowed to call the API (CORS).
# Several addresses: separate with commas. In production use your real https address.
FRONTEND_URL=http://localhost:5173

# Reports and dashboards group days using this timezone
APP_TIMEZONE=Asia/Kolkata

# Email (password reset links). Leave empty to print emails in the server log instead
EMAIL_API_KEY=
EMAIL_FROM=Sports Room <no-reply@example.com>

# Equipment and profile photos (Cloudinary). Without these, photo upload answers 503
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
